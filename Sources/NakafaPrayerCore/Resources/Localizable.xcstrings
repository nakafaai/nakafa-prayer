    "focus.consent_message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus Mode will cover every connected display for %d minutes when Nakafa Prayer is running. It starts automatically at prayer time, may start up to 5 minutes after wake, and can always be ended with its button or Escape. App switching remains available." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Mode Fokus akan menutupi setiap layar yang terhubung selama %d menit ketika Nakafa Prayer berjalan. Mode ini dimulai otomatis pada waktu salat, dapat dimulai hingga 5 menit setelah Mac bangun, dan selalu dapat diakhiri dengan tombolnya atau Escape. Pergantian aplikasi tetap tersedia." } }
      }
    },
    "focus.consent_title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Focus Mode?" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Aktifkan Mode Fokus?" } }
      }
    },
    "focus.countdown" : {
