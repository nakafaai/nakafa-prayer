    "focus.help" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Optional full-screen prayer prompt while the app is running. Notifications remain the reliable reminder channel." } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Pengingat salat layar penuh opsional ketika aplikasi berjalan. Notifikasi tetap menjadi saluran pengingat yang andal." } }
